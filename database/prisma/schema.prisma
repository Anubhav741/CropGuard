// =============================================================
// AquaGuardian – Prisma Schema
// File:    database/prisma/schema.prisma
// Author:  Yash Kumar
// Purpose: Prisma ORM model definitions that mirror the existing
//          PostgreSQL schema (schema.sql).
//          Run: npx prisma migrate dev --name init
//          from the project root to apply this schema.
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  // Set DATABASE_URL in .env, e.g.:
  // DATABASE_URL="postgresql://anubhavgupta@localhost:5432/aquaguardian"
}

// =============================================================
// Model: User
// Mirrors: CREATE TABLE users (...)
// One user can have many game sessions.
// =============================================================
model User {
  userId       Int           @id @default(autoincrement()) @map("user_id")
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at")

  // Relation: one User → many GameSessions
  sessions     GameSession[]

  @@map("users")
}

// =============================================================
// Model: Scenario
// Mirrors: CREATE TABLE scenarios (...)
// One scenario can appear in many game sessions.
// =============================================================
model Scenario {
  scenarioId   Int           @id @default(autoincrement()) @map("scenario_id")
  scenarioName String        @map("scenario_name") @db.VarChar(150)
  description  String        @db.Text
  difficulty   Difficulty

  // Relation: one Scenario → many GameSessions
  sessions     GameSession[]

  @@map("scenarios")
}

// PostgreSQL CHECK constraint modelled as an enum in Prisma
enum Difficulty {
  Easy
  Medium
  Hard
}

// =============================================================
// Model: GameSession
// Mirrors: CREATE TABLE game_sessions (...)
// Links a User to a Scenario. One session → at most one result.
// =============================================================
model GameSession {
  sessionId   Int          @id @default(autoincrement()) @map("session_id")
  userId      Int          @map("user_id")
  scenarioId  Int          @map("scenario_id")
  startedAt   DateTime     @default(now()) @map("started_at")
  endedAt     DateTime?    @map("ended_at")       // nullable – NULL while in progress
  status      SessionStatus @default(ongoing)

  // Relations
  user        User         @relation(fields: [userId],     references: [userId])
  scenario    Scenario     @relation(fields: [scenarioId], references: [scenarioId])
  result      GameResult?  // at most one result per session (1-to-0..1)

  @@map("game_sessions")
}

// Maps to: CHECK (status IN ('ongoing', 'completed', 'abandoned'))
enum SessionStatus {
  ongoing
  completed
  abandoned
}

// =============================================================
// Model: GameResult
// Mirrors: CREATE TABLE game_results (...)
// Exactly one result per completed session. sessionId is @unique.
// =============================================================
model GameResult {
  resultId           Int          @id @default(autoincrement()) @map("result_id")
  sessionId          Int          @unique @map("session_id")  // enforces one-to-one
  score              Int
  groundwaterBefore  Int          @map("groundwater_before")
  groundwaterAfter   Int          @map("groundwater_after")
  waterSaved         Int          @map("water_saved")
  completedAt        DateTime     @default(now()) @map("completed_at")

  // Relation: each result belongs to exactly one session
  session            GameSession  @relation(fields: [sessionId], references: [sessionId])

  @@map("game_results")
}
