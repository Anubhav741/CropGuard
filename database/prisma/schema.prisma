// =============================================================
// AquaGuardian – Prisma Schema
// File:    database/prisma/schema.prisma
// Author:  Yash Kumar
// Version: Prisma 6.19.3 (LTS / Stable ORM)
// =============================================================
// CONSISTENCY NOTE: Difficulty & Status (CHECK Constraints vs Enum)
// In database/schema.sql, PostgreSQL enforces data integrity using:
//   CHECK (difficulty IN ('Easy', 'Medium', 'Hard'))
//   CHECK (status IN ('ongoing', 'completed', 'abandoned'))
// Prisma ORM represents PostgreSQL VARCHAR columns with CHECK
// constraints as `String @db.VarChar(20)`, but does not encode the CHECK.
// Migration 1_restore_checks explicitly installs the CHECK constraints.
// For application-level compile-time safety, TypeScript union types are used:
//   export type Difficulty = 'Easy' | 'Medium' | 'Hard';
//   export type SessionStatus = 'ongoing' | 'completed' | 'abandoned';
// =============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================
// Model: User
// Mirrors: CREATE TABLE users (...)
// =============================================================
model User {
  userId       Int           @id @default(autoincrement()) @map("user_id")
  name         String        @db.VarChar(100)
  email        String        @unique @db.VarChar(255)
  passwordHash String        @map("password_hash") @db.VarChar(255)
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(6)
  
  // 1:N Relation – One player has many sessions
  sessions     GameSession[]

  @@map("users")
}

// =============================================================
// Model: Scenario
// Mirrors: CREATE TABLE scenarios (...)
// =============================================================
model Scenario {
  scenarioId   Int           @id @default(autoincrement()) @map("scenario_id")
  scenarioName String        @map("scenario_name") @db.VarChar(150)
  description  String        @db.Text
  difficulty   String        @db.VarChar(20)
  
  // 1:N Relation – One scenario is played in many sessions
  sessions     GameSession[]

  @@map("scenarios")
}

// =============================================================
// Model: GameSession
// Mirrors: CREATE TABLE game_sessions (...)
// =============================================================
model GameSession {
  sessionId  Int         @id @default(autoincrement()) @map("session_id")
  userId     Int         @map("user_id")
  scenarioId Int         @map("scenario_id")
  startedAt  DateTime    @default(now()) @map("started_at") @db.Timestamp(6)
  endedAt    DateTime?   @map("ended_at") @db.Timestamp(6)
  status     String      @default("ongoing") @db.VarChar(20)

  // Relations
  user       User        @relation(fields: [userId], references: [userId], onDelete: NoAction, onUpdate: NoAction)
  scenario   Scenario    @relation(fields: [scenarioId], references: [scenarioId], onDelete: NoAction, onUpdate: NoAction)
  
  // 1:0..1 Relation – A session has at most one result
  result     GameResult?

  @@map("game_sessions")
}

// =============================================================
// Model: GameResult
// Mirrors: CREATE TABLE game_results (...)
// =============================================================
model GameResult {
  resultId          Int         @id @default(autoincrement()) @map("result_id")
  sessionId         Int         @unique @map("session_id") // Strict 1:1 enforcement
  score             Int
  groundwaterBefore Int         @map("groundwater_before")
  groundwaterAfter  Int         @map("groundwater_after")
  waterSaved        Int         @map("water_saved")
  completedAt       DateTime    @default(now()) @map("completed_at") @db.Timestamp(6)

  // Relation back to game_sessions
  session           GameSession @relation(fields: [sessionId], references: [sessionId], onDelete: NoAction, onUpdate: NoAction)

  @@map("game_results")
}
